# KWin window rule for the sensor panel window, applied to ~/.config/kwinrulesrc by install.sh.
# Matches the Chrome app window by its exact title (the <title> in panel.html) and pins it borderless over the
# panel output without taking focus. Flatpak Chrome now gives every window the class com.google.Chrome, so the
# title is what tells the panel apart from normal browser windows (those always end in "- Google Chrome").
# position/size must match where the panel sits in your display layout (System Settings > Display & Monitor).
Description=Sensor Panel on secondary display
wmclass=com.google.Chrome
wmclassmatch=1
wmclasscomplete=false
title=SensorPanel
titlematch=1
position=3440,0
positionrule=2
size=1280,400
sizerule=2
screen=1
screenrule=2
fullscreen=false
fullscreenrule=2
decorationpolicy=none
decorationpolicyrule=2
minimize=false
minimizerule=2
acceptfocus=false
acceptfocusrule=2
fsplevel=4
fsplevelrule=2
skiptaskbar=true
skiptaskbarrule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
